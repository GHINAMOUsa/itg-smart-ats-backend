# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:1239@localhost:5432/itg_career

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# AI resume analysis (app/ai_service.py)
# Leave ANTHROPIC_API_KEY empty to fall back to a simple deterministic skill-overlap
# scorer instead of calling a real LLM. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
RESUME_TEXT_MAX_CHARS=15000
GEMINI_API_KEY=